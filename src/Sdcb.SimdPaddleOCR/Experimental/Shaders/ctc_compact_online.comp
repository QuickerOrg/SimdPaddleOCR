#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#ifdef F16
#extension GL_EXT_shader_16bit_storage : require
#define ET float16_t
#else
#define ET float
#endif
layout(local_size_x = 256) in;
layout(set=0,binding=0) readonly buffer X { ET x[]; };
layout(set=0,binding=1) writeonly buffer O { ET o[]; };
layout(push_constant) uniform PC { uint rows, columns; } p;
shared float maxima[256], sums[256];
shared uint ids[256];
void main() {
 uint row=gl_WorkGroupID.x,t=gl_LocalInvocationID.x;
 if(row>=p.rows)return;
 float best=-3.402823466e38,sum=0.0;uint id=0xffffffffu;
 // One input read per logit. Keep a stable online softmax denominator per lane.
 for(uint c=t;c<p.columns;c+=256u){
  float v=float(x[row*p.columns+c]);
  if(v>best){sum=sum*exp(best-v)+1.0;best=v;id=c;}
  else{sum+=exp(v-best);if(v==best && c<id)id=c;}
 }
 float groupMax=subgroupMax(best);
 uint groupId=subgroupMin(best==groupMax?id:0xffffffffu);
 float groupSum=subgroupAdd(sum*exp(best-groupMax));
 if(subgroupElect()){maxima[gl_SubgroupID]=groupMax;sums[gl_SubgroupID]=groupSum;ids[gl_SubgroupID]=groupId;}
 barrier();
 if(t==0u){
  best=maxima[0];id=ids[0];
  for(uint g=1u;g<gl_NumSubgroups;g++)if(maxima[g]>best || (maxima[g]==best && ids[g]<id)){best=maxima[g];id=ids[g];}
  sum=0.0;for(uint g=0u;g<gl_NumSubgroups;g++)sum+=sums[g]*exp(maxima[g]-best);
  uint bits=floatBitsToUint(1.0/sum),b=row*6u;
  o[b]=ET(id&255u);o[b+1u]=ET(id>>8u);
  for(uint k=0u;k<4u;k++)o[b+2u+k]=ET((bits>>(8u*k))&255u);
 }
}
